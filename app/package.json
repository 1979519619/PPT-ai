{
  "name": "ppt-ai",
  "version": "0.4.0-preview.1",
  "private": true,
  "description": "PPT-AI 课堂助手",
  "author": "PPT-AI",
  "main": "m1/main.js",
  "license": "Apache-2.0",
  "dependencies": {
    "katex": "^0.19.1",
    "koffi": "^3.3.5",
    "opencc-js": "^1.4.2"
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.pptai.classroom",
    "productName": "PPT-AI Classroom",
    "directories": {
      "output": "dist/0.4.0-preview.1"
    },
    "files": [
      "m1/**/*",
      "!m1/out/**/*",
      "!m1/package.json",
      "!m1/*.ps1",
      "!m1/*.py",
      "!m1/ocr-requirements.txt",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/koffi/**"
    ],
    "extraResources": [
      {
        "from": "asr",
        "to": "asr",
        "filter": ["ggml-small.bin", "Release/whisper-server.exe", "Release/*.dll"]
      },
      {
        "from": "m1/detector.ps1",
        "to": "detector.ps1"
      },
      {
        "from": "ocr-runtime",
        "to": "ocr-runtime",
        "filter": [
          "**/*",
          "!**/__pycache__/**", "!**/*.pyc", "!**/*.pyo",
          "!site-packages/pip/**", "!site-packages/pip-*.dist-info/**",
          "!site-packages/setuptools/**", "!site-packages/setuptools-*.dist-info/**",
          "!site-packages/wheel/**", "!site-packages/wheel-*.dist-info/**",
          "!site-packages/_distutils_hack/**", "!site-packages/distutils-precedence.pth",
          "!site-packages/bin/**", "!site-packages/share/**",
          "!site-packages/**/tests/**", "!site-packages/**/test/**",
          "!site-packages/rapidocr/models/**"
        ]
      },
      {
        "from": "m1/ocr-worker.py",
        "to": "ocr-worker.py"
      },
      {
        "from": "m1/slide-text.ps1",
        "to": "slide-text.ps1"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PPT-AI 课堂助手",
      "artifactName": "PPT-AI-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false,
      "license": "../LICENSE",
      "runAfterFinish": false,
      "installerLanguages": ["zh_CN"],
      "displayLanguageSelector": false,
      "include": "build/installer.nsh"
    },
    "extraFiles": [
      {
        "from": "../LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "../NOTICE",
        "to": "NOTICE.txt"
      },
      {
        "from": "build/generated/PRIVACY.txt",
        "to": "PRIVACY.txt"
      },
      {
        "from": "../third_party/licenses",
        "to": "third-party-licenses"
      },
      {
        "from": "../third_party/OCR-NOTICE.md",
        "to": "third-party-licenses/OCR-NOTICE.md"
      },
      {
        "from": "../third_party/VC-REDIST-NOTICE.md",
        "to": "third-party-licenses/VC-REDIST-NOTICE.md"
      }
    ],
    "electronVersion": "45.1.0",
    "electronDist": "node_modules/electron/dist"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64",
    "test": "node --test ../tests/*.test.cjs"
  }
}
